---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { emph, heroHeadline } from '../lib/text';

const settings = await getEntry('site', 'settings');
const s = settings!.data;
---

<Layout>
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="nav-logo" href="/" aria-label="finant home">
        <img src="/assets/logo-lockup.png" alt="finant" />
      </a>
      <nav class="nav-links" aria-label="primary">
        {s.nav_links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <a href="#contact" class="nav-cta">{s.nav_cta_label}</a>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-main">
        <div class="eyebrow hero-eyebrow">
          <span class="pulse" aria-hidden="true"></span>
          {s.hero_eyebrow}
        </div>

        <h1 set:html={heroHeadline(s.hero_headline)} />
      </div>

      <div class="hero-side">
        <p class="lede" set:html={emph(s.hero_lede)} />

        <div class="cta-row">
          <a href="#contact" class="btn-primary">
            {s.hero_cta_label}
            <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M1 6h10M7 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <div class="hero-meta">
          {s.hero_meta.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </div>

    <svg class="hero-mark" viewBox="0 0 188 188" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="0" y="0" width="188" height="188" rx="41.36" fill="#0A0A0A"/>
      <g fill="#FFFFFF">
        <circle cx="94"  cy="46"  r="12"/>
        <circle cx="138" cy="46"  r="12"/>
        <circle cx="50"  cy="78"  r="12"/>
        <circle cx="94"  cy="78"  r="12"/>
        <circle cx="138" cy="78"  r="12"/>
        <circle cx="50"  cy="110" r="12"/>
        <circle cx="94"  cy="110" r="12"/>
        <circle cx="94"  cy="142" r="12"/>
      </g>
    </svg>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[...s.ticker_items, ...s.ticker_items].map((item) => (
        <span set:html={item} />
      ))}
    </div>
  </div>

  <section class="manifesto reveal" id="thesis">
    <div class="wrap manifesto-inner">
      <div class="manifesto-label">{s.manifesto_label}</div>
      <p set:html={emph(s.manifesto_body)} />
    </div>
  </section>

  <section class="pillars reveal" id="building">
    <div class="wrap">
      <div class="pillars-head">
        <div>
          <span class="eyebrow">{s.pillars_eyebrow}</span>
          <h2 set:html={emph(s.pillars_heading)} />
        </div>
      </div>

      <div class="pillars-grid">
        {s.pillars.map((pillar, i) => (
          <article class="pillar">
            <span class="pillar-num">{pillar.num}</span>
            {i === 0 && (
              <svg class="pillar-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="18" cy="18" r="14" stroke="currentColor" stroke-width="1.4"/>
                <path d="M18 8v10l6 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
            )}
            {i === 1 && (
              <svg class="pillar-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M4 28L14 18l6 6 12-14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M24 10h8v8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
            {i === 2 && (
              <svg class="pillar-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="10" cy="10" r="3" stroke="currentColor" stroke-width="1.4"/>
                <circle cx="26" cy="10" r="3" stroke="currentColor" stroke-width="1.4"/>
                <circle cx="10" cy="26" r="3" stroke="currentColor" stroke-width="1.4"/>
                <circle cx="26" cy="26" r="3" stroke="currentColor" stroke-width="1.4"/>
                <path d="M13 10h10M10 13v10M26 13v10M13 26h10" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            )}
            <h3>{pillar.title}</h3>
            <p set:html={emph(pillar.body)} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="audiences reveal">
    <div class="wrap audiences-grid">
      <div class="audiences-head">
        <span class="label">{s.audiences_label}</span>
        <h2 set:html={emph(s.audiences_heading)} />
        <p class="audiences-intro" set:html={emph(s.audiences_intro)} />
      </div>
      <ul class="audiences-list">
        {s.audiences.map((name, i) => (
          <li>
            <span class="num">/ {String(i + 1).padStart(2, '0')}</span>
            <span class="name">{name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="founders reveal" id="team">
    <div class="wrap">
      <div class="founders-head">
        <div>
          <span class="eyebrow">{s.founders_eyebrow}</span>
          <h2 set:html={emph(s.founders_heading)} />
        </div>
      </div>

      <div class="founders-grid">
        {s.founders.map((f) => (
          <article class="founder">
            <span class="role">{f.role}</span>
            <h3>{f.name}</h3>
            <p set:html={emph(f.bio)} />
            <div class="founder-prev">
              {f.prev.map((tag) => <span>{tag}</span>)}
            </div>
            <a class="founder-link" href={f.linkedin} target="_blank" rel="noopener">
              LinkedIn
              <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3 9l6-6M4 3h5v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="contact reveal" id="contact">
    <div class="wrap contact-inner">
      <div class="contact-head">
        <span class="label">{s.contact_label}</span>
        <h2 set:html={emph(s.contact_heading)} />
        <p set:html={emph(s.contact_body)} />
        <p style="margin-top: 28px;">
          <a href={`mailto:${s.contact_email}`} class="contact-email">
            {s.contact_email}
          </a>
        </p>
      </div>

      <form
        class="contact-form"
        id="earlyAccessForm"
        name="early-access"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        novalidate
      >
        <input type="hidden" name="form-name" value="early-access" />
        <p class="hp-field" aria-hidden="true">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>
        <div class="field">
          <label class="field-label" for="ea-name">{s.contact_form_name_label}</label>
          <input id="ea-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label class="field-label" for="ea-email">{s.contact_form_email_label}</label>
          <input id="ea-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label class="field-label" for="ea-role">{s.contact_form_role_label}</label>
          <select id="ea-role" name="role" required>
            <option value="">{s.contact_form_role_placeholder}</option>
            {s.contact_form_role_options.map((opt) => (
              <option value={opt}>{opt}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label class="field-label" for="ea-note">{s.contact_form_note_label}</label>
          <textarea id="ea-note" name="note" rows="2" placeholder={s.contact_form_note_placeholder}></textarea>
        </div>
        <button type="submit">
          {s.contact_form_submit_label}
          <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M1 6h10M7 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <p class="contact-fineprint">{s.contact_form_fineprint}</p>
        <p class="contact-status" id="earlyAccessStatus" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <footer>
    <div class="wrap">
      <div class="footer-inner">
        <div class="footer-mark">
          <img src="/assets/logo-lockup.png" alt="finant" />
          <p class="tagline">{s.footer_tagline}</p>
        </div>
        <div class="footer-meta">
          {s.footer_links.map((link) => {
            const external = link.href.startsWith('http');
            return external
              ? <a href={link.href} target="_blank" rel="noopener">{link.label}</a>
              : <a href={link.href}>{link.label}</a>;
          })}
        </div>
      </div>
      <div class="footer-bottom">
        <span>{s.footer_copyright}</span>
        <span>{s.footer_status}</span>
      </div>
    </div>
  </footer>
</Layout>
